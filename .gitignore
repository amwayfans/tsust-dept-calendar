# ============================================================
# ⚠️ 絕對不要提交任何「機密」金鑰
#    service_role key、資料庫密碼、LINE token、API key 都不可以進來。
#
#    assets/config.js 會被提交，這是刻意的：
#    它裡面只有 publishable / anon key，那個金鑰本來就是設計給瀏覽器用的，
#    權限由資料庫的 RLS 控制。請不要把 service_role key 加到 config.js。
# ============================================================

# 環境變數
.env
.env.*
!.env.example

# 本機覆寫（放私密設定用）
*.local.js
*.local.css

# 真實資料，不進公開版控（這個 repo 是公開的）
# seed_roster.sql 含全系教師的信箱，所以排除。
# 需要的人請跟系辦索取，或參考 seed_roster.example.sql 自行填寫。
supabase/seed_roster.sql

# 深耕調查的種子資料含「目前分配」的教師姓名，比照上一條排除。
# 要重建請跟系辦索取，或直接看 Supabase 資料庫裡的現況。
supabase/seed_survey_deepfarm.sql
supabase/survey_setup_ALL.sql

# 系統 / 編輯器
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# 本機測試用的暫時頁面（由 scripts/make_probe.py 產生，測完就刪）
# 裡面會假造登入 session，不該進版控。
_probe*.html
